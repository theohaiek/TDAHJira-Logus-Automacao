{
  "name": "tdah-logus",
  "version": "1.3.0",
  "description": "Gerenciador de tarefas visual: a simplicidade de uma planilha com a rastreabilidade de um issue tracker.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theohaiek/TDAHJira-Logus-Automacao.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "setup": "node server/index.js --setup",
    "demo": "node server/index.js --demo",
    "test": "node --test \"tests/*.test.js\"",
    "relatos": "node scripts/relatos/rodar.mjs",
    "relatos:verificar": "node scripts/relatos/rodar.mjs --verificar",
    "relatos:configurar": "node scripts/relatos/rodar.mjs --configurar",
    "relatos:agendar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/relatos/agendar.ps1"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.0"
  }
}
